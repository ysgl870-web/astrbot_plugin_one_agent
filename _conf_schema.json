{
  "enabled": {
    "description": "启用待办插件",
    "type": "bool",
    "default": true,
    "hint": "关闭后指令与自动提醒均暂停。"
  },
  "default_priority": {
    "description": "默认优先级",
    "type": "string",
    "default": "中",
    "options": ["高", "中", "低"],
    "labels": ["高", "中", "低"],
    "hint": "用户没有指定优先级时使用此值。"
  },
  "max_todos": {
    "description": "单会话最大待办数量",
    "type": "int",
    "default": 100,
    "hint": "限制单个群聊或私聊会话最多保存多少条待办。"
  },
  "auto_assign": {
    "description": "启用自助代办",
    "type": "bool",
    "default": true,
    "hint": "允许用户使用“自助代办”认领一项未认领任务。"
  },
  "reminder_enabled": {
    "description": "启用提醒系统",
    "type": "bool",
    "default": true,
    "hint": "关闭后单项提醒和每日提醒都不会自动发送。"
  },
  "default_daily_reminder_time": {
    "description": "默认每日提醒时间",
    "type": "string",
    "default": "18:00",
    "hint": "新会话首次开启每日提醒时使用的默认时间。"
  }
}
